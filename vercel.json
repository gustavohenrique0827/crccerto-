{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": { "api/**/*.ts": { "maxDuration": 60 } },
  "crons": [{ "path": "/api/clinicorp/sync", "schedule": "0 9 * * *" }],
  "headers": [{ "source": "/version.json", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] }],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
