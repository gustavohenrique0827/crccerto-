{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "schedules": {
    "clinicorp-sync": {
      "schedule": "0 9 * * *",
      "path": "/api/clinicorp/sync",
      "requestMethod": "GET"
    },
    "whatsapp-labels": {
      "schedule": "*/15 * * * *",
      "path": "/api/whatsapp/live",
      "requestMethod": "GET"
    }
  }
}
